# Copy to .env.local and fill in. Set the same vars in the Vercel project settings.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
KLORA_SESSION_SECRET=change-me-to-a-long-random-string

# Password-reset email (Resend). Without RESEND_API_KEY, reset OTP works only in dev
# (code logged/returned) and is DISABLED in production. EMAIL_FROM needs a Resend-verified
# domain; the onboarding@resend.dev default only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=KLORA <onboarding@resend.dev>

# Public origin — used for OAuth redirect URIs and links in emails (defaults to the request host).
NEXT_PUBLIC_BASE_URL=https://corta.tech

# "Sign in with Google" (Google Cloud → APIs & Services → Credentials → OAuth client ID, Web app).
# Authorised redirect URIs: https://corta.tech/api/auth/google/callback
#                           https://www.corta.tech/api/auth/google/callback
#                           http://localhost:3000/api/auth/google/callback
# Without both vars the Google button reports "ยังไม่ได้เปิดใช้งาน" and password login still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
